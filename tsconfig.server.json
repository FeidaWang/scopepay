{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "NodeNext",
    "moduleResolution": "NodeNext", "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "outDir": "dist/server", "rootDir": ".",
    "types": ["node"], "sourceMap": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts"],
  "exclude": ["server/dev.ts"]
}
