# Node.js 24 or newer. No credentials are required for Example mode.
PORT=3000
DATABASE_PATH=data/scopepay.sqlite
# Set to the full browser origin when deployed, e.g. https://scopepay.example.com
# APP_URL=http://localhost:3000
# Optional explicit development preview hostnames (comma-separated).
# DEV_ALLOWED_HOSTS=preview.example.test

# example = deterministic walkthrough, clearly labelled; not a live AI model.
# ollama = local model. openai-compatible = a compatible chat-completions API.
AI_PROVIDER=example
AI_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_KEY=

# This application deliberately implements PayPal sandbox only.
PAYMENT_PROVIDER=example
# PAYMENT_PROVIDER=paypal-sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MERCHANT_EMAIL=
# PAYPAL_WEBHOOK_ID=
